# Ghostty configuration
#
# All options with docs: ghostty +show-config --default --docs
# Reload while running: cmd+shift+, (some options apply only to new windows
# or after a full restart).
# Comments must be on their own line: a trailing "# ..." becomes part of the value.

# Theme
# ==========================
# Explicit pin of the built-in default colors
theme = Ghostty Default Style Dark
# High-contrast dark alternatives: uncomment one and comment out the line above
# theme = IR Black
# theme = GitHub Dark High Contrast
# theme = iTerm2 Pastel Dark Background
# theme = Vesper
# theme = Xcode Dark hc

# Font
# ==========================
font-size = 13

# Mouse and clipboard
# ==========================
# Copy selection to the system clipboard
copy-on-select = clipboard
mouse-hide-while-typing = true

# Scrollback
# ==========================
# History size per terminal, in bytes (default: 10 MB)
scrollback-limit = 50000000

# Keyboard
# ==========================
# Left Option acts as Alt; right Option still types special characters
macos-option-as-alt = left
# `shift+enter` inserts new line in terminal
keybind = shift+enter=text:\x1b\r

# Quick terminal
# ==========================
# cmd+shift+t works while Ghostty is focused, cmd+shift+opt+t from any app
keybind = cmd+shift+t=toggle_quick_terminal
keybind = global:cmd+shift+opt+t=toggle_quick_terminal
quick-terminal-position = top
# size of quick terminal: height and width
quick-terminal-size = 50%,100%
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true
quick-terminal-space-behavior = move

# Shell integration
# ==========================
# ssh: install Ghostty terminfo on remote hosts (needs `tic` there),
# fall back to TERM=xterm-256color if that fails.
# Features not listed here (cursor, sudo, title) keep their defaults.
shell-integration-features = ssh-terminfo,ssh-env
