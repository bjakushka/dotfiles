{
  "description": "Global Codex hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'f=\"$HOME/.dotfiles/_local/AGENTS.local.md\"; if [ -f \"$f\" ]; then printf \"Local instructions loaded from %s:\\n\\n\" \"$f\"; cat \"$f\"; fi'"
          },
          {
            "type": "command",
            "command": "printf '%s\\n' 'Collaboration checkpoint: do only the smallest step needed to form a useful answer or hypothesis, then ask before deeper investigation, workaround, implementation, cleanup, migration, or scope expansion.'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'Collaboration checkpoint: do only the smallest step needed to form a useful answer or hypothesis, then ask before deeper investigation, workaround, implementation, cleanup, migration, or scope expansion.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Use revdiff for proposed edits before approval. Approval in revdiff is approval to apply that exact change; do not ask again unless the change, scope, or risk changed.\"}}'"
          }
        ]
      }
    ]
  }
}
