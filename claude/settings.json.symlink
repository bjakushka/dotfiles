{
  "permissions": {
    "allow": [
      "Bash(cp:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(which:*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"additionalContext\": \"Use the revdiff skill to show diffs and proposed edits to the user, not plaintext in chat. Preview unapplied multi-file edits from a temp git worktree.\"}}'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "sandbox": {
    "excludedCommands": [
      "*/launch-revdiff.sh*"
    ]
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "advisorModel": "opus",
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "stable",
  "disableAutoMode": true,
  "tui": "fullscreen",
  "theme": "dark",
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
